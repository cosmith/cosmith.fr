{
  "name": "cosmith-website",
  "version": "1.0.0",
  "description": "Personal website backed by local SQLite content",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx site/build.ts --dev",
    "build": "tsx site/build.ts",
    "serve": "tsx site/build.ts --serve",
    "build:site": "tsx site/build.ts",
    "dev:site": "tsx site/build.ts --dev --port 9000"
  },
  "dependencies": {
    "@types/node": "^24.2.0",
    "chokidar": "^4.0.3",
    "commander": "12.1.0",
    "tsx": "4.20.6"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
